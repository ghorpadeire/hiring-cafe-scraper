# hiring-cafe-scraper — Environment Variables
# Copy this file to .env and fill in your values.
# The tool works WITHOUT a token on home/residential internet.
# A token is only needed when running from cloud servers (AWS, VPS, GitHub Actions).

# Apify API token — for Cloudflare bypass via residential proxy
# Get yours free at: https://console.apify.com/account/integrations
# Note: Cloudflare bypass requires Apify's RESIDENTIAL proxy plan.
# APIFY_TOKEN=apify_api_xxxxxxxxxxxxxxxxxxxx
